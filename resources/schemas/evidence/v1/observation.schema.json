{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voku:php-runtime-audit:evidence:v1:observation",
  "title": "PHP Runtime Audit Observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "schema_version", "observation_id", "collector_id", "asset_id", "observed_at", "redaction_status", "sources", "facts"],
  "properties": {
    "record_type": {"const": "observation"},
    "schema_version": {"const": "1.0"},
    "observation_id": {"$ref": "#/$defs/id"},
    "collector_id": {"$ref": "#/$defs/id"},
    "asset_id": {"$ref": "#/$defs/id"},
    "observed_at": {"$ref": "#/$defs/timestamp"},
    "redaction_status": {"enum": ["not_applied", "partial", "complete", "unknown"]},
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/source"}
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {"$ref": "#/$defs/fact"}
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "timestamp": {"type": "string", "maxLength": 40, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$", "format": "date-time"},
    "digest": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "kind", "locator", "captured_at", "captured_digest", "current_digest", "freshness"],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["file", "package_database", "runtime_report", "vendor_advisory", "manual", "other"]},
        "locator": {"type": "string", "minLength": 1, "maxLength": 256},
        "captured_at": {"$ref": "#/$defs/timestamp"},
        "captured_digest": {"$ref": "#/$defs/digest"},
        "current_digest": {"$ref": "#/$defs/digest"},
        "freshness": {"enum": ["fresh", "stale", "unknown"]}
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "key", "value", "source_id"],
      "properties": {
        "fact_id": {"$ref": "#/$defs/id"},
        "key": {"type": "string", "minLength": 1, "maxLength": 128},
        "value": {"type": ["null", "boolean", "number", "string", "object", "array"]},
        "source_id": {"$ref": "#/$defs/id"}
      }
    }
  }
}
