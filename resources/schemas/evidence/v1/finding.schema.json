{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voku:php-runtime-audit:evidence:v1:finding",
  "title": "PHP Runtime Audit Finding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "schema_version", "finding_id", "subject_id", "created_at", "status", "kind", "material", "title", "observed_impact", "evidence_ids", "independent_verification"],
  "properties": {
    "record_type": {"const": "finding"},
    "schema_version": {"const": "1.0"},
    "finding_id": {"$ref": "#/$defs/id"},
    "subject_id": {"$ref": "#/$defs/id"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "status": {"enum": ["confirmed", "needs_validation", "rejected"]},
    "kind": {"enum": ["vulnerability", "compromise_indicator", "configuration", "unknown"]},
    "material": {"type": "boolean"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "observed_impact": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 1000}]},
    "evidence_ids": {"$ref": "#/$defs/evidence_ids"},
    "independent_verification": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/verification"}]}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "confirmed"}}, "required": ["status"]},
      "then": {"properties": {"evidence_ids": {"minItems": 1}}
      }
    },
    {
      "if": {"properties": {"status": {"const": "confirmed"}, "material": {"const": true}}, "required": ["status", "material"]},
      "then": {"properties": {"independent_verification": {"$ref": "#/$defs/verification"}}
      }
    }
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "timestamp": {"type": "string", "maxLength": 40, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$", "format": "date-time"},
    "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifier_id", "verified_at", "method", "evidence_ids"],
      "properties": {
        "verifier_id": {"$ref": "#/$defs/id"},
        "verified_at": {"$ref": "#/$defs/timestamp"},
        "method": {"type": "string", "minLength": 1, "maxLength": 256},
        "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    }
  }
}
