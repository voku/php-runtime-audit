{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voku:php-runtime-audit:evidence:v1:applicability",
  "title": "PHP Runtime Audit Applicability v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "schema_version", "record_id", "subject_id", "check_id", "assessed_at", "state", "evidence_ids", "reason"],
  "properties": {
    "record_type": {"const": "applicability"},
    "schema_version": {"const": "1.0"},
    "record_id": {"$ref": "#/$defs/id"},
    "subject_id": {"$ref": "#/$defs/id"},
    "check_id": {"$ref": "#/$defs/id"},
    "assessed_at": {"$ref": "#/$defs/timestamp"},
    "state": {"enum": ["true", "false", "unknown"]},
    "evidence_ids": {"$ref": "#/$defs/evidence_ids"},
    "reason": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 1000}]}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "unknown"}}, "required": ["state"]},
      "then": {"properties": {"reason": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"state": {"enum": ["true", "false"]}}, "required": ["state"]},
      "then": {"properties": {"evidence_ids": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "timestamp": {"type": "string", "maxLength": 40, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$", "format": "date-time"},
    "evidence_ids": {"type": "array", "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  }
}
